<?xml version="1.0" encoding="utf-8"?>
<!-- "Mochi & Claude" on the home screen (widget/MochiWidgetProvider.kt): Mochi and what Claude is doing, Claude's
     sessions, and "Waiting for you", on a clay card that follows the phone's light or dark theme. The texts here are
     what shows before the app has said anything. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mochi_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_scene"
            android:layout_width="88dp"
            android:layout_height="46dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/mochi_scene_idle" />

        <ImageView
            android:id="@+id/widget_mochi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textStyle="bold"
                android:maxLines="2"
                android:text="@string/mochi_widget_label"
                android:textColor="@color/mochi_widget_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                        android:maxLines="2"
                android:text="@string/mochi_widget_open_mochi"
                android:textColor="@color/mochi_widget_ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/mochi_widget_well"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_sessions_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textStyle="bold"
            android:importantForAccessibility="noHideDescendants"
            android:maxLines="1"
            android:textColor="@color/mochi_widget_ink_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/widget_session_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_waiting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/mochi_widget_well"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/mochi_widget_inbox" />

            <TextView
                android:id="@+id/widget_waiting_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/mochi_widget_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_waiting_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mochi_widget_badge"
                android:textStyle="bold"
                android:minWidth="22dp"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:textColor="@color/mochi_widget_on_tint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_waiting_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
                android:importantForAccessibility="noHideDescendants"
            android:maxLines="2"
            android:textColor="@color/mochi_widget_ink_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/mochi_widget_ink_secondary"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
