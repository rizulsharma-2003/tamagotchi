<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The relay (WebSocket and HTTPS). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Alerts from your Mac as notifications (asked for at first launch on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Scanning the Mac's pairing QR code (asked for when you tap Scan). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Hold to talk: the microphone, only while you hold Mochi (asked for the first time you do). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="Mochi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- MainActivity hands Mochi's links (pairing, the widget's places) to the app itself; Flutter's own deep
                 linking would treat them as routes. Flutter reads this here, on the activity. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- Press and hold Mochi's icon: Talk to Mochi, What's waiting, Check now; and what Google Assistant can
                 ask Mochi (A4). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The Mac's pairing link: mochi://pair?v=1&relay=…&room=…&invite=…&key=…&name=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mochi" android:host="pair"/>
            </intent-filter>
        </activity>
        <!-- Reply and Mark done in a notification: flutter_local_notifications' receiver starts a background isolate
             (mochiNotificationAction) that sends them, even with Mochi closed. Only the app's own notifications reach it. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>
        <!-- "Talk to Mochi" in Quick Settings (TalkTileService.kt): opens Mochi listening. Only Android's Quick Settings
             can bind it. -->
        <service
            android:name=".TalkTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_mochi"
            android:label="@string/mochi_tile_talk"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false"/>
        </service>
        <!-- The home-screen widget, "Mochi & Claude" (widget/MochiWidgetProvider.kt). Only Android talks to it. -->
        <receiver
            android:name=".widget.MochiWidgetProvider"
            android:exported="false"
            android:label="@string/mochi_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mochi_widget_info"/>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Hold to talk: the phone's speech recognizer (package visibility on Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Read aloud: the phone's text-to-speech engine (package visibility on Android 11+). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- url_launcher: opening links in the browser and in their apps (Gmail, Meet, Notion). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
