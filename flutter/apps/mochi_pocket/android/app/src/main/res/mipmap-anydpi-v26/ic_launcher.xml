<?xml version="1.0" encoding="utf-8"?>
<!-- The iPhone app's icon (Mochi and Patch on peach), inset into the adaptive icon's 72 dp safe zone so every launcher
     mask shows both of them whole. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.67%"/>
    </foreground>
</adaptive-icon>
